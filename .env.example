# Frontend (Vite)
VITE_CONTACT_API_ENDPOINT=/api/contact
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
VITE_SITE_URL=https://www.inaivosolutions.com

# Backend (Vercel Serverless /api/contact)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
CONTACT_RECEIVER_EMAIL=admin@inaivosolutions.com

# Optional: set this if you want FormSubmit as explicit transport override
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/admin@inaivosolutions.com

# Optional: use Resend instead of FormSubmit (recommended for production email reliability)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Inaivo Solutions <noreply@yourdomain.com>
